# Copy to .env.local and fill in. Never commit real values.

# Signs sessions and login links. Required in production.
SESSION_SECRET=

# Opens the /access page in production (/access?key=...).
ACCESS_KEY=

# Google Gemini, for the resident's assistant and for reading uploaded reports.
# Get a free key at https://aistudio.google.com/apikey. Without it, Masar uses
# its own written explanations and passes uploaded reports to the doctor unread.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
