# Copy to .env.local and fill in. Never commit real values.

# Signs sessions and login links. Required in production.
SESSION_SECRET=

# Opens the /access page in production (/access?key=...).
ACCESS_KEY=

# Google Gemini, for the resident's assistant and for reading uploaded reports.
# Get a free key at https://aistudio.google.com/apikey. Without it, Masar uses
# its own written explanations and passes uploaded reports to the doctor unread.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
# Demo only. GEMINI_MOCK=1 with no key runs the onboarding journey's two final
# questions and summary through a labelled mock: consent is still checked, the
# call is logged as "demo mock, no live model call", and the output is
# validated, but nothing is sent anywhere. Ignored when GEMINI_API_KEY is set.
GEMINI_MOCK=
